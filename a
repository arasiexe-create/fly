-- 単位略称化 (1Q = 1京)
local function formatNumberShort(num)
	if num >= 1000000000000000 then return string.format("%.2fQ", num / 1000000000000000)
	elseif num >= 1000000000000 then return string.format("%.2fT", num / 1000000000000)
	elseif num >= 1000000000 then return string.format("%.2fB", num / 1000000000)
	elseif num >= 1000000 then return string.format("%.2fM", num / 1000000)
	elseif num >= 1000 then return string.format("%.1fk", num / 1000)
	else return tostring(num) end
end

